# =============================================================================
# Meridian Configuration
# =============================================================================
# Copy to .env and customize as needed. All values have sensible defaults.

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Docling Service ---
DOCLING_SERVICE_HOST=0.0.0.0
DOCLING_SERVICE_PORT=8001
DOCLING_MAX_CONCURRENT=10
DOCLING_REQUEST_TIMEOUT=300
DOCLING_TEMP_DIR=/tmp/docling_service

# OCR (disabled by default - VLMs handle visual content)
DOCLING_OCR_ENABLED=false
DOCLING_OCR_ENGINE=easyocr

# Table structure
DOCLING_TABLE_STRUCTURE=true
DOCLING_TABLE_MODE=accurate

# GPU / Accelerator
DOCLING_ACCELERATOR_DEVICE=auto
DOCLING_ACCELERATOR_THREADS=4

# Batch processing
DOCLING_DOC_BATCH_SIZE=4
DOCLING_DOC_BATCH_CONCURRENCY=4
DOCLING_PAGE_BATCH_SIZE=4

# Image extraction
DOCLING_IMAGE_SCALE=2.0
DOCLING_TABLE_PADDING=70
DOCLING_FORMULA_PADDING=20
DOCLING_PICTURE_PADDING=10

# PDF backend: "pypdfium2" (fastest), "v2" (default), "v4" (best semantic)
DOCLING_PDF_BACKEND=v2

# --- Docling Client (load balancing) ---
DOCLING_INSTANCES=http://localhost:8001,http://localhost:8002,http://localhost:8003,http://localhost:8004,http://localhost:8005,http://localhost:8006,http://localhost:8007,http://localhost:8008

# --- vLLM ---
VLLM_API_URL=http://localhost:8000/v1/chat/completions
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLLM_GPU_MEMORY_UTILIZATION=0.55
VLLM_MAX_NUM_SEQS=128

# --- VLM backend ---
# 'vllm' (default) runs the vision model locally on your GPU.
# 'bedrock' sends VLM work to AWS Bedrock instead -- no local vision
# model required. Needs: pip install 'meridian[bedrock]' + AWS creds.
VLM_BACKEND=vllm

# Only read when VLM_BACKEND=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_MAX_CONCURRENCY=5
BEDROCK_MAX_IMAGE_DIM=1536

# --- Ollama (Embeddings) ---
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b-q8_0
EMBEDDING_DIMENSIONS=1024

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=meridian_documents

# --- Image Service ---
IMAGE_SERVICE_PORT=9847
PDF_DIR=/mnt/pdfs

# --- Workers ---
CELERY_CONCURRENCY=3
