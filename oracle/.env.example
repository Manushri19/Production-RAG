# =============================================================================
# Oracle Configuration
# =============================================================================
# Copy to .env and customize. All values have sensible defaults.

# --- Oracle API ---
ORACLE_HOST=0.0.0.0
ORACLE_PORT=8010
ORACLE_LOG_LEVEL=INFO

# --- Qdrant (shared with Meridian) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=meridian_documents

# --- Ollama Embedding (shared with Meridian) ---
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b-q8_0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30.0

# --- Reranker Sidecar ---
RERANKER_URL=http://localhost:8011
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=30.0

# --- vLLM (shared with Meridian) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLLM_API_KEY=EMPTY
VLLM_MAX_TOKENS=1024
VLLM_TEMPERATURE=0.1
VLLM_TIMEOUT_SECONDS=120.0

# --- Retrieval Tuning ---
# Hybrid search candidate pool size (dense + sparse RRF)
HYBRID_TOP_K=30
# Final context chunks after reranking (sent to LLM)
FINAL_TOP_K=5
# HNSW recall quality parameter (higher = better recall, slower)
HNSW_EF=128
